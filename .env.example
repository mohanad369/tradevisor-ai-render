# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
ADMIN_PASSWORD=           # Server-side admin password for /api/admin/login
ADMIN_PASSWORD_HASH=      # Optional HMAC-SHA256 hash of admin password
DEVELOPER_PASSWORD=       # Server-side developer password for /api/developer/login
DEVELOPER_PASSWORD_HASH=  # Optional HMAC-SHA256 hash of developer password

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# Public frontend -> backend connection
# Example for GitHub Pages build:
# VITE_API_ORIGIN=https://your-backend.onrender.com
VITE_API_ORIGIN=
VITE_TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Backend CORS allowlist, comma-separated extras
PUBLIC_SITE_ORIGIN=https://mohanad369.github.io
PUBLIC_SITE_ORIGIN_WWW=https://tradevisorai369.b-cdn.net
PUBLIC_EXTRA_SITE_ORIGINS=https://tradevisorai.com,https://www.tradevisorai.com,https://tradevisortrading.com,https://www.tradevisortrading.com
